# EN: copy this file to .env for local use ("python scripts/dev.py up" does it for you).
#     DUMMY values only. The real .env is git-ignored and never committed.
# Franco: e3mel copy lel file da esmo .env lel estekhdam el local ("python scripts/dev.py up" beye3melha).
#     values wahmeya bas. El .env el 7a2i2i git-ignored w 3omro ma byetrafe3.

# --- Postgres admin (used ONLY by the postgres container and by "node infra/db/load.js"; never by the services)
POSTGRES_USER=ett_admin
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=ett
POSTGRES_SERVICE=postgres

# --- one login per service (least privilege): svc_s1, svc_s2, svc_s3. Pick any values for local use.
DB_S1_PASSWORD=local-s1-change-me
DB_S2_PASSWORD=local-s2-change-me
DB_S3_PASSWORD=local-s3-change-me

# --- where the services find each other and the database inside Docker
DB_HOST=postgres
DB_PORT=5432
S1_URL=http://s1:5001
S2_URL=http://s2:5002
S3_URL=http://s3:5003

# --- Floci (fake AWS): dummy keys only
AWS_ENDPOINT_URL=http://floci:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
CERTIFICATES_BUCKET=certificates

# --- Cognito: copy the ids printed by "node infra/floci/cognito/cognito_init.js" (public ids, not secrets)
COGNITO_ISSUER=
COGNITO_WEB_CLIENT_ID=
COGNITO_SERVICE_CLIENT_ID=
COGNITO_JWKS_URL=
TEST_USER_PASSWORD=Test@12345678
