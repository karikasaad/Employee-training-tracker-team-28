{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnSecretsOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:*:secret:ett/db*",
        "arn:aws:secretsmanager:*:*:secret:ett/service-client*"
      ]
    },
    {
      "Sid": "WriteOwnLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/ett/s3:*"
      ]
    }
  ]
}
